# ──────────────────────────────────────────────────────────
# FacultyIS — Environment Configuration
# ──────────────────────────────────────────────────────────
# Copy this file to .env and customize:
#   cp .env.example .env && chmod 600 .env
#
# ┌──────────────────────────────────────────────────────┐
# │  DEVELOPMENT: The defaults work out of the box.      │
# │  Set DEV_MODE=1 to accept the insecure JWT secret.   │
# │                                                      │
# │  PRODUCTION: You MUST set a strong JWT_SECRET and    │
# │  leave DEV_MODE unset. See README.md for details.    │
# └──────────────────────────────────────────────────────┘
# ──────────────────────────────────────────────────────────

# ── JWT Secret ────────────────────────────────────────────
# DEVELOPMENT: The default below is accepted when DEV_MODE=1.
# PRODUCTION: Generate a strong secret:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Then paste the output as JWT_SECRET=<your-secret>
# NEVER use the default in production.
JWT_SECRET=dev-insecure-please-change-me

# ── Dev Mode ──────────────────────────────────────────────
# Set DEV_MODE=1 to accept the insecure default JWT_SECRET.
# Without this, start.sh will refuse to run with the default secret.
# PRODUCTION: Leave this commented out or unset.
# DEV_MODE=1

# ── JWT token lifetime (seconds) ──────────────────────────
JWT_TTL_SECONDS=3600

# ── Rate limiting ─────────────────────────────────────────
# Max requests per minute per user (in-process)
RATE_LIMIT_PER_MINUTE=30

# ── Flask API logging ─────────────────────────────────────
# LOG_LEVEL: DEBUG, INFO, WARNING (default), ERROR, CRITICAL
LOG_LEVEL=WARNING
# ACCESS_LOG: set to "true" to enable access logs (default: false)
ACCESS_LOG=false

# ── Service ports (defaults are fine for local dev) ───────
# FLASK_PORT=5000
# PHP_PORT=8080
