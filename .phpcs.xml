<?xml version="1.0"?>
<!-- PHP_CodeSniffer configuration for FacultyIS -->
<ruleset name="FacultyIS">
    <description>FacultyIS PHP coding standard</description>

    <!-- Base standard -->
    <rule ref="PSR12"/>

    <!-- Paths to check -->
    <file>php-app/src</file>
    <file>php-app/public</file>

    <!-- Exclude generated/vendor files -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/uploads/*</exclude-pattern>

    <!-- Relax line length for SQL queries and template lines -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="200"/>
        </properties>
    </rule>
</ruleset>
